# ============================================================================
# IMPACT7 PLATFORM — Exemplo de variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie para `.env` e preencha. NUNCA comite o `.env` real (já está no
# .gitignore). Em produção (Railway/Manus), configure via Secrets do provedor.
# ============================================================================

# --- Núcleo (OBRIGATÓRIO) ---------------------------------------------------
NODE_ENV=production
PORT=3000
# String de conexão MySQL 8.0+ (ex.: mysql://user:pass@host:3306/impact7)
DATABASE_URL=
# Segredo para assinatura dos tokens JWT (gere com: openssl rand -base64 32)
JWT_SECRET=

# --- URLs da aplicação ------------------------------------------------------
VITE_APP_URL=https://seu-dominio.com
VITE_APP_ID=impact7

# --- LLM / IA (Jarvis) ------------------------------------------------------
# A base usa o proxy Manus Forge (compatível OpenAI) para o modelo de chat.
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=
# Provider de EMBEDDINGS do RAG. Padrão = local (determinístico, offline).
# Quando um provider remoto estiver disponível, defina para "forge" e
# implemente remoteEmbedding() em server/services/jarvis/embeddings.ts.
EMBEDDINGS_PROVIDER=local

# --- Pagamentos: Stripe (necessário p/ assinaturas) -------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Email transacional: SendGrid (necessário p/ emails reais) --------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=contato@seu-dominio.com

# --- Observabilidade: Sentry (opcional, recomendado em produção) ------------
# Se preenchido, o error tracking pode ser ativado. Ver GUIA_LANCAMENTO.md.
SENTRY_DSN=

# --- OAuth (opcional — a base usa auth JWT própria por padrão) --------------
OAUTH_SERVER_URL=
